# Copie este arquivo para .env e preencha os valores reais
# NUNCA commite o arquivo .env

# ─── GroqCloud — Chave compartilhada (usada como fallback para todos os agentes) ───
# Gere sua chave em: https://console.groq.com/keys
# ATENÇÃO: chaves expiram ou são revogadas — se os agentes retornarem erro 401,
# gere uma nova chave no console.groq.com e atualize este arquivo.
GROQ_API_KEY=gsk_SUA_CHAVE_AQUI

# ─── GroqCloud — Chaves específicas por agente (opcional) ────────────────────────
# Se definidas, têm prioridade sobre GROQ_API_KEY para o agente correspondente
GROQ_API_KEY_MARKET=
GROQ_API_KEY_SOCIAL=
GROQ_API_KEY_CONSOLIDATOR=

# ─── GroqCloud — Modelos (padrões já configurados, altere se necessário) ──────────
# Verifique modelos disponíveis via: GET /api/groq/validar
# Modelos confirmados disponíveis no GroqCloud (free tier, 2026-11):
#   llama-3.3-70b-versatile  — melhor qualidade, mais lento
#   llama-3.1-8b-instant     — rápido, bom para agentes especializados
#   llama3-8b-8192           — alternativa rápida
#   gemma2-9b-it             — alternativa Google
# Nota: se receber HTTP 404 da Groq, o modelo foi removido/renomeado.
#       Use GET /api/groq/validar para listar os modelos disponíveis na sua conta.
GROQ_MODEL_MARKET=llama-3.1-8b-instant
GROQ_MODEL_SOCIAL=llama-3.1-8b-instant
GROQ_MODEL_CONSOLIDATOR=llama-3.3-70b-versatile

# ─── GroqCloud — Limites de consumo ───────────────────────────────────────────────
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2

# ─── Configurações da aplicação ───────────────────────────────────────────────────
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true

# ─── Banco de dados SQLite ────────────────────────────────────────────────────────
DB_PATH=./nexora.db

# ─── CORS — origem permitida do frontend ──────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
